node_modules
npm-debug.log
yarn-error.log

# Build output
dist
build
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml

# Documentation
README.md
CHANGELOG.md
LICENSE
docs

# Testing
coverage
.nyc_output
*.test.ts
*.spec.ts
test

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore